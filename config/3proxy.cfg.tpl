# TwinGate - generated by scripts/render-config.sh, do not edit by hand.
# 3proxy 明文端口默认只监听回环；TLS 入口由 ttp 负责。

nserver ${TWIN_DNS_SERVER}
# nserver 是明文 UDP 53：串到上游代理后面、或者真的出了国，这里就是"第一次几秒、
# 之后 2~3 秒"的主要来源。用 TWIN_DNS_TIMEOUTS 收紧超时与重试次数。
nscache 65536
# ${TWIN_TIMEOUTS} 由渲染脚本按 TWIN_*_TIMEOUT 拼出（见 config/ports.env）：
#   SINGLEBYTE_S SINGLEBYTE_L STRING_S STRING_L CONNECTION_S CONNECTION_L
#   DNS_TO CHAIN_TO CONNECT_TO CONNBACK_TO LINGER_TO
# 默认值：1 5 30 60 180 1800 15 60 15 5 5（上游是慢的外网代理时，
# CONNECT_TO=15 太短，"有时候能连、有时候 ERR_TUNNEL_CONNECTION_FAILED"多半是它）。
timeouts ${TWIN_TIMEOUTS}
log ${TWIN_LOG_DIR}/3proxy.log
logformat "- +_L%t.%.  %N.%p %E %U %C:%c %R:%r %O %I %h %T"

external ${TWIN_EXTERNAL}
# 认证开关由 scripts/render-config.sh 按 TWIN_AUTH 渲染
__TWIN_USERS_LINE__
__TWIN_AUTH_MODE__

# @service:http
# ---------------- HTTP 代理 ----------------
flush
allow __TWIN_ALLOW__
# parent 由 scripts/parent.sh 按 TWIN_PARENT 注入（必须紧跟 allow 行）
__TWIN_PARENT__
internal ${TWIN_HTTP_BIND}
proxy -p${TWIN_HTTP_PLAIN}
# @end

# @service:socks
# ---------------- SOCKS4/5 ----------------
flush
allow __TWIN_ALLOW__
# 同上：所有客户端共享同一个上游 SOCKS5
__TWIN_PARENT__
internal ${TWIN_SOCKS_BIND}
socks -p${TWIN_SOCKS_PLAIN}
# @end

# @service:ftp
# ---------------- FTP 代理 ftppr ----------------
# 客户端用户名格式：ftpuser@ftpserver；开启认证时为 代理用户:代理密码:ftpuser@ftpserver
# 注意：ftppr 不支持 parent 链式转发，启用上游时本段会被改成 deny。
flush
allow __TWIN_ALLOW__
internal ${TWIN_FTP_BIND}
ftppr -p${TWIN_FTP_PLAIN}
# @end
