# TwinGate - generated by scripts/render-config.sh, do not edit by hand.
# 3proxy 明文端口默认只监听回环；TLS 入口由 ttp 负责。

nserver ${TWIN_DNS_SERVER}
nscache 65536
timeouts 1 5 30 60 180 1800 15 60
log ${TWIN_LOG_DIR}/3proxy.log
logformat "- +_L%t.%.  %N.%p %E %U %C:%c %R:%r %O %I %h %T"

external ${TWIN_EXTERNAL}
# 认证开关由 scripts/render-config.sh 按 TWIN_AUTH 渲染
__TWIN_USERS_LINE__
__TWIN_AUTH_MODE__

# @service:http
# ---------------- HTTP 代理 ----------------
flush
allow __TWIN_ALLOW__
internal ${TWIN_HTTP_BIND}
proxy -p${TWIN_HTTP_PLAIN}
# @end

# @service:socks
# ---------------- SOCKS4/5 ----------------
flush
allow __TWIN_ALLOW__
internal ${TWIN_SOCKS_BIND}
socks -p${TWIN_SOCKS_PLAIN}
# @end

# @service:ftp
# ---------------- FTP 代理 ftppr ----------------
# 客户端用户名格式：ftpuser@ftpserver
flush
allow __TWIN_ALLOW__
internal ${TWIN_FTP_BIND}
ftppr -p${TWIN_FTP_PLAIN}
# @end
