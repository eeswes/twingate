# TwinGate 默认端口规划（可在容器里通过环境变量覆盖）
# TLS 入口由 ttp 监听；明文入口由 3proxy 监听，仅绑定 127.0.0.1。
# 所有变量都写成 ${VAR:-default}，允许外部环境变量覆盖。

TWIN_HTTP_TLS=${TWIN_HTTP_TLS:-18080}
TWIN_HTTP_PLAIN=${TWIN_HTTP_PLAIN:-31808}

TWIN_SOCKS_TLS=${TWIN_SOCKS_TLS:-11080}
TWIN_SOCKS_PLAIN=${TWIN_SOCKS_PLAIN:-31080}

TWIN_FTP_TLS=${TWIN_FTP_TLS:-10021}
TWIN_FTP_PLAIN=${TWIN_FTP_PLAIN:-30021}

# 3proxy 内部 DNS 缓存用的上游 DNS（如容器无外网可改为本地 DNS）
TWIN_DNS_SERVER=${TWIN_DNS_SERVER:-8.8.8.8}

# 3proxy 出站监听地址；0.0.0.0 表示使用系统默认路由
TWIN_EXTERNAL=${TWIN_EXTERNAL:-0.0.0.0}

# 明文入口绑定地址。默认仅本机回环，供 ttp 解密后转发使用。
# 如需让主机或其他设备直连明文端口，显式设为 0.0.0.0（无认证，注意安全）。
TWIN_PLAIN_BIND=${TWIN_PLAIN_BIND:-127.0.0.1}
# 各协议明文后端可单独覆盖绑定地址，默认继承 TWIN_PLAIN_BIND。
TWIN_HTTP_BIND=${TWIN_HTTP_BIND:-$TWIN_PLAIN_BIND}
TWIN_SOCKS_BIND=${TWIN_SOCKS_BIND:-$TWIN_PLAIN_BIND}
TWIN_FTP_BIND=${TWIN_FTP_BIND:-$TWIN_PLAIN_BIND}

# 单端口混合模式（默认关闭）
# TWIN_MIXED=1 时：只启动 1 个 tgmux 明文端口 + 1 个 ttp TLS 端口，
# HTTP/CONNECT/SOCKS5/FTP 都走同一个端口。原有 6 端口拓扑不再启动。
TWIN_MIXED=${TWIN_MIXED:-0}
TWIN_MUX_PLAIN=${TWIN_MUX_PLAIN:-37890}
TWIN_MIXED_TLS=${TWIN_MIXED_TLS:-17890}
TWIN_MUX_BIND=${TWIN_MUX_BIND:-${TWIN_PLAIN_BIND}}

# 要开放哪些服务（逗号分隔）。可选值：
#   http-tls, http-plain, socks-tls, socks-plain, ftp-tls, ftp-plain
#   mixed-tls, mixed-plain
# 留空时保持旧行为：TWIN_MIXED=1 开两个混合端口，否则开六个传统端口。
# 例如只要两个混合端口：TWIN_SERVICES=mixed-tls,mixed-plain
TWIN_SERVICES=${TWIN_SERVICES:-}
# tgmux 等待客户端首字节的时间；FTP 客户端会等服务端先发 220，所以这里超时后按 FTP 处理。
TWIN_MUX_PEEK_MS=${TWIN_MUX_PEEK_MS:-500}

# 用户名/密码认证（默认开启，便于给局域网设备使用）
# 默认凭据只是开箱即用，请务必修改，或设 TWIN_AUTH=0 关闭认证。
# 用户名/密码只允许字母、数字、. _ @ -（3proxy 配置格式限制）。
TWIN_AUTH=${TWIN_AUTH:-1}
TWIN_AUTH_USER=${TWIN_AUTH_USER:-twingate}
TWIN_AUTH_PASS=${TWIN_AUTH_PASS:-twingate123}

# 日志目录
TWIN_LOG_DIR=${TWIN_LOG_DIR:-./logs}
